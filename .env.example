# =============================================================================
# MiMa Second Hand — Environment template
# =============================================================================
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit `.env`, `.env.local` or any file containing real secrets.
# Set the production values in the Vercel project (Settings → Environment
# Variables), NOT in the repository.
#
# Rule of thumb:
#   - SECRET values  -> no NEXT_PUBLIC_ prefix, server-side only.
#   - PUBLIC values  -> NEXT_PUBLIC_ prefix, safe to ship to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Integration mode (server-only). Controls whether the integration layer serves
# mock data or talks to the real Pladsly API. Defaults to "mock" when unset.
#   mock -> use bundled placeholder data (safe default, no network)
#   live -> use the real Pladsly API (requires the secret credentials below)
# (`DATA_SOURCE=mock|pladsly` is still accepted as a backward-compatible alias.)
# -----------------------------------------------------------------------------
PLADSLY_INTEGRATION_MODE=mock

# -----------------------------------------------------------------------------
# MiMa operations provider (server-only).
#   native    -> in-process store (default, prototype)
#   supabase  -> reserved; fails closed until a project is connected
#   pladsly   -> reserved; no undocumented booking API
# -----------------------------------------------------------------------------
OPERATIONS_PROVIDER=native

# Local staff sketch at /intern. Must stay unset in production.
MIMA_INTERNAL_UI=

# Allow POST /api/mima/bookings (pending_payment only, no Stripe). Off by default.
MIMA_NATIVE_BOOKING=

# Invented occupancy for local QA only. Must stay unset in production.
MIMA_DEMO_OCCUPANCY=

# -----------------------------------------------------------------------------
# Pladsly SECRET credentials — SERVER SIDE ONLY.
# These MUST NOT be prefixed with NEXT_PUBLIC_ and MUST NOT reach the browser.
# Leave empty here; set real values only in the Vercel dashboard.
# -----------------------------------------------------------------------------
PLADSLY_API_KEY=
PLADSLY_API_BASE_URL=

# -----------------------------------------------------------------------------
# Public Pladsly URLs — safe to expose to the browser (NEXT_PUBLIC_ prefix).
# These are plain links the website points visitors to; they are NOT secrets.
# The values below are the currently known public endpoints and are safe
# examples. Confirm/adjust before production.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLADSLY_PORTAL_URL=https://portal.pladsly.app/
NEXT_PUBLIC_PLADSLY_SHOP_URL=https://mima.pladsly.app/default/shop/all
NEXT_PUBLIC_PLADSLY_BOOKING_URL=https://mima.pladsly.app/default/wizard/package

# -----------------------------------------------------------------------------
# CCM19 Cloud — public embed (NOT a secret).
# The dashboard key is already the default in src/config/ccm19.ts.
# Override only if the CCM19 domain/key changes. Layout and cookie list are
# managed in the CCM19 administration, not here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CCM19_API_KEY=
NEXT_PUBLIC_CCM19_DOMAIN=
